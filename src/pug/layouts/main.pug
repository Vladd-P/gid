block vars

include ../mixins/_svg
if account
	include ../mixins/_account-aside

<!DOCTYPE html>
html(lang="en")
	head
		meta(charset="UTF-8")
		meta(name="viewport", content="width=device-width, initial-scale=1.0")
		title= title

		link(rel="icon" href="data:,")

		link(rel="stylesheet", href="css/bootstrap.min.css")
		if swiper 
			link(rel="stylesheet", href="css/swiper-bundle.min.css")
		if tomselect 
			link(rel="stylesheet", href="css/tom-select.bootstrap4.min.css")
		link(rel="stylesheet", href="css/fancybox.css")
		link(rel="stylesheet", href="css/main.css")

		block head

	body(class=(account && body != 'white') ? 'account-page' : '')
		if account 
			.top-block
				include ../components/_header-account
		else
			.top-block
				include ../components/_topline
				include ../components/_header
				include ../components/_nav

		block main

		if !noFooter
			include ../components/_footer

		if account
			include ../components/_menu-bottom

		block modals
			if !account
				include ../components/_modal-login
			include ../components/_modal-feedback

		block scripts
			script(src="js/jquery.min.js" defer)
			script(src="js/bootstrap.bundle.min.js" defer)
			if yamaps 
				script(src="https://api-maps.yandex.ru/2.1/?lang=ru_RU")
				if yamaps == 'aside-map.js'
					script
						include ../../js/maps/aside-map.js
				if yamaps == 'map-search.js'
					script
						include ../../js/maps/map-search.js
				if yamaps == 'acc-add-map.js'
					script
						include ../../js/maps/acc-add-map.js
			if swiper 
				script(src="js/swiper-bundle.min.js" defer)
			if tomselect 
				script(src="js/tom-select.complete.min.js" defer)
			if inputmask 
				script(src="js/inputmask.min.js" defer)
			script(src="js/fancybox.umd.js" defer)
			script(src="js/main.js" defer)
		