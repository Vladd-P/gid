extends ../layouts/main

block vars 
	- var title = 'Карточка врача'
	- var swiper = true
	- var tomselect = true

include ../mixins/_favorites
include ../mixins/_card-comment

block main
	section.page-section.container-fluid
		ul.brdcrumbs
			li: a(href="/") Главная
			li
				+svg('arrow-brdcrumbs', 16, 16)
				a(href="catalog-services.html") Услуги
			li 
				+svg('arrow-brdcrumbs', 16, 16)
				|ПрофМедГрупп

		.card-main
			aside
				.card-info.card-aside-block
					.aside-block__header
						img.card-info__doctor-av(src="img/card-doctor-av.webp", alt="")
						.card-info__name Позднякова Вера Сергеевна
						.rating-line 
							.stars
								+svg('star-rating', 16,16)
								+svg('star-rating', 16,16)
								+svg('star-rating', 16,16)
								+svg('star-rating', 16,16)
								+svg('star-rating', 16,16)
							mark 5.0
							a.link-blue(href="#") 25 отзывов
						p.card-info__numbers 6 подписчиков, 3 подписки
						button.card-info__comment.button-gray-color-primary Оставить отзыв

					.card-info__address 
						span Компания:
						a.link-blue(href="#") ООО «ПрофМедГрупп»
						span Регион:
						p Московская область и Москва
						span Адрес:
						p Лескова 8, кв. 218

					.card-info__controls
						span.button-gray.button-40 
							+svg('verified-ok',16,16)
							|Телефон подтвержден
						span.button-gray.button-40 
							+svg('verified-ok',16,16)
							|Документы проверены
						.collapse-custom 
							.collapse-custom__content 
								button.button-gray.button-40.w-100 2 объявления пользователя
							.collapse-custom__btn.collapse-custom__btn--switch.link-blue
								span Показать еще 2
								span Скрыть

					.card-info__feedback 
						button.button-primary Показать номер
						button.button-bordered-blue Написать 
						button.button-gray.w-100 Подписаться

					.card-info__answer
						+svg('clock', 16,16)
						|Отвечает около часа
					
					.card-info__contacts
						a(href="mailto:medkrasotunov24.ru") medkrasotunov24.ru
						.card-info__sots 
							a(href="#"): img(src="img/ico-sots-whatsapp.svg", alt="")
							a(href="#"): img(src="img/ico-sots-tg.svg", alt="")
							a(href="#"): img(src="img/ico-sots-vk.svg", alt="")

			main 
				.card-block
					.key-value 
						span Стаж:
						p 16 лет
					.key-value 
						span Тип приема:
						p В клинике
					.key-value.flex-column 
						span Специальность:
						p Научное звание и медицинская категория: кандидат медицинских наук, вторая категория

					.card-tags
						span.active Дерматолог
						span Косметолог
						span Трихолог
						span Дермановенеролог
						span Косметолог-дерматолог
					
					.block-liner

					.card-slider-wrapper
						.card-slider.swiper
							.swiper-wrapper 
								.swiper-slide: img(src="img/card-doctor-slide-1.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-1.webp")
								.swiper-slide: img(src="img/card-doctor-slide-2.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-2.webp")
								.swiper-slide: img(src="img/card-doctor-slide-3.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-3.webp")
								.swiper-slide: img(src="img/card-doctor-slide-4.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-4.webp")
								.swiper-slide: img(src="img/card-doctor-slide-5.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-5.webp")
								.swiper-slide: img(src="img/card-doctor-slide-6.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-6.webp")
								.swiper-slide.swiper-slide--more(data-slides=7)
									img(src="img/card-doctor-slide-7.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-7.webp")
									span
								.swiper-slide.d-none: img(src="img/card-doctor-slide-1.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-1.webp")
								.swiper-slide.d-none: img(src="img/card-doctor-slide-2.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-2.webp")
								.swiper-slide.d-none: img(src="img/card-doctor-slide-3.webp", alt="" data-fancybox-img data-fancybox="card-doctor" data-src="img/card-doctor-slide-3.webp")
						button.swiper-button-prev: +svg('arrow-comments', 20, 20)
						button.swiper-button-next: +svg('arrow-comments', 20, 20)

					.subtitle Описание
					.card-text-collapse.collapse-custom 
						.collapse-custom__content 
							|Меня зовут Вера Сергеевна. Я врач-дерматовенеролог, косметолог, трихолог и даже невролог. Окончила Рниму им. Пирогова. В профессии уже более 10 лет. Принимаю пациентов в Москве. Всегда индивидуальный подход и сопровождение после процедур!
						.collapse-custom__btn.collapse-custom__btn--switch.link-blue
							span Читать полностью
							span Скрыть	
							+svg('arrow-collapse', 16,16)(class="collapse-custom__caret")

				.tabs-common 
					button.active(data-tabs='card-doctor-tabs' data-tab-target='card-doctor-tabs-services') Объявления
					button(data-tabs='card-doctor-tabs' data-tab-target='card-doctor-tabs-comments') Отзывы

				.card-list-filter 
					select.card-list-filter__select.select-styled
						option Популярные
						option Непопулярные
					a(href="#"): +svg('map-marker', 20,20)

				#card-doctor-tabs-services.active(data-tabs-content='card-doctor-tabs')
					.card-list-service
						figure.card-list-service__img
							a(href="#"): img(src="img/card-list-service-1.webp", alt="")
							+favorites
						.card-list-service__title Комбинированная чистка лица лазером (глубокая)
						.card-list-service__cost 5 900 ₽
						.card-list-service__about Аппаратная косметология, Московская область и Москва, Лескова 8, кв. 218
					.card-list-service
						figure.card-list-service__img
							a(href="#"): img(src="img/card-list-service-2.webp", alt="")
							+favorites
						.card-list-service__title Биоревитализация препаратом Novacutan YBio (2 мл)
						.card-list-service__cost 5 900 ₽
						.card-list-service__about Аппаратная косметология, Московская область и Москва, Лескова 8, кв. 218

				#card-doctor-tabs-comments(data-tabs-content='card-doctor-tabs')
					+card-comment
					+card-comment
					+card-comment

	include ../components/_last-vews
