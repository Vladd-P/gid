								option ₾
								option €

			.acc-add-description.account-main.account-main--block
				.column
					.title-20 Контактная информация
					.acc-add-contact 
						.color-grey2 Телефон
						.column 
							input.form-control(type="tel" placeholder='+7 (___)-___-__-__')
							div 
								label.checkbox-styled
									input(type="checkbox")
									figure: +svg('checkbox', 14,14)
									|Доступен в WhatsApp
								label.checkbox-styled
