						label
							input(type="checkbox")
							|Оплата картой
						label
							input(type="checkbox")
							|Оплата онлайн

			.account-main.account-main--block
				.column
					.title-20 Местоположение
					.column
						.form-group 
							label Адрес
							input.form-control(placeholder='Начните вводить адрес, а потом выберите из списка')
							.acc-add-annotation.color-grey3.mt-1 Если вы хотите указать более точные координаты на карте, вы можете ввести страну, штат/регион, город и адрес и через запятые выполнить поиск, а затем перетащить маркер в нужное место на карте
						.maw-300.form-group 
							label Регион							
							select.select-styled(data-placeholder="Выберите регион")
								option(value="" selected disabled)
								option region 1
								option region 2 
						.maw-300.form-group 
							label Населённый пункт							
							select.select-styled(data-placeholder="Выберите населенный пункт")
								option(value="" selected disabled)
								option city 1
								option city 2 
					#acc-add-map

			.account-main.account-main--block
				.column
					div
						.title-20.mb-2 Фотографии
						.acc-add-annotation.color-grey2 Первое фото будет отображаться в результатах поиска, выберите наиболее удачное. Вы можете загрузить до 20 фотографий в формате JPG или PNG. Максимальный размер фото — 25mb.
					label.acc-add-photos 
						input(type="file")
						figure: +svg('acc-add-photo', 32,32)
						.fw-500 Загрузите фото или перетащите сюда файлы
						.acc-add-annotation.color-grey3 Пожалуйста, загрузите максимум 12 фотографий, размер одного изображения: 10 МБ.
					div
						.title-20.mt-sm-2.mb-2 Видео
						.acc-add-annotation.color-grey2 Можно добавить ссылку на видеоролик в Youtube, Rutube или Vimeo
					.form-group-url 
						figure: +svg('link', 20,20)
						input(type="url" placeholder='Например https://www.youtube.com/watch…')

			.acc-add-description.account-main.account-main--block
