extends ../layouts/main

block vars 
	- var title = 'Главная'
	- var swiper = true
	- var tomselect = true

include ../mixins/_previews


block main
	section.main-banner.page-section
		.container-fluid 
			.main-banner__body
				img.main-banner_bg(src="img/main-banner.webp", alt="")

				.main-banner__title 
					|Найдите косметолога в 
					span.primary Санкт-Петербурге 
					|из разных клиник по всей России
				p В каталоге более 500 специалистов по разным услугам по всей России

				.search-object
					.search-object__tabs 
						button.active(data-tabs="search-object" data-tab-target="search-object-service") Найти услугу
						button(data-tabs="search-object" data-tab-target="search-object-doctor") Найти врача
						button(data-tabs="search-object" data-tab-target="search-object-clinic") Найти клинику

					.search-object__type.active(id="search-object-service" data-tabs-content="search-object")
						.search-object__filters 
							select.select-styled(data-placeholder="Регион")
								option(value="" selected disabled)
								option Московская область
								option Лениградская область
								option Курская область
								option Белгородская область
								option Рязанская область
								option Калининградская область
							select.select-styled(data-placeholder="Тип приема")
								option(value="" selected disabled)
								option в клинике 
								option на дому 
							select.select-styled(data-placeholder="Специализация")
								option(value="" selected disabled)
								option Клиника 
								option Врач
								option Специалист
							select.select-styled(data-placeholder="Лечение")
								option(value="" selected disabled)
								option Дерматология 
								option Дерматология 								
								option Стоматология 								
							select.select-styled(data-placeholder="Все услуги")
								option(value="" selected disabled)
								option Аппаратная косметология 
								option Аппаратная косметология 								
								option Диетология, спорт, тренировки 								
								option Инъекционная косметология 								
								option Лазерная хирургия 								
								option Макияж и татуаж	
							button.search-object__submit.button-primary(type="submit")
								+svg('search-filter', 20,20)
								|Найти

					.search-object__type(id="search-object-doctor" data-tabs-content="search-object")
						.search-object__filters
							select.select-styled(multiple data-placeholder="Регион")
								option(value="" selected disabled)
								option Московская область
								option Лениградская область
								option Курская область
								option Белгородская область
								option Рязанская область
								option Калининградская область
							select.select-styled(data-placeholder="Тип приема")
								option(value="" selected disabled)
								option в клинике 
								option на дому 
							select.select-styled(data-placeholder="Специализация")
								option(value="" selected disabled)
								option Врач-стоматолог  
								option Врач-диетолог
								option Врач по спортивной медицине								
							select.select-styled(multiple data-placeholder="Пол врача")
								option(value="" selected disabled)
								option мужчина 
								option женщина
							select.select-styled(data-placeholder="Популярные")
								option(value="" selected disabled)
								option по рейтингу 
								option по отзывам
								option по дате добавления
							select.select-styled(data-placeholder="Стаж от __ и до __")
								option(value="" selected disabled)
								option от 0 до 60 лет 
								option от 10 до 60 лет
								option от 30 до 60 лет
							button.search-object__submit.button-primary(type="submit")
								+svg('search-filter', 20,20)
								|Найти								

					.search-object__type(id="search-object-clinic" data-tabs-content="search-object")
						.search-object__filters 
							select.select-styled(multiple data-placeholder="Регион")
								option(value="" selected disabled)
								option Московская область
								option Лениградская область
								option Курская область
								option Белгородская область
								option Рязанская область
								option Калининградская область
							select.select-styled(data-placeholder="Тип приема")
								option(value="" selected disabled)
								option в клинике 
								option на дому 
							select.select-styled(multiple data-placeholder="Специализация")
								option(value="" selected disabled)
								option Клиника 
								option Врач
								option Специалист							
							select.select-styled(data-placeholder="Все услуги")
								option(value="" selected disabled)
								option Аппаратная косметология 
								option Аппаратная косметология 								
								option Диетология, спорт, тренировки 								
								option Инъекционная косметология 								
								option Лазерная хирургия 								
								option Макияж и татуаж	
							select.select-styled(data-placeholder="Популярные")
								option(value="" selected disabled)
								option по рейтингу 
								option по отзывам
								option по дате добавления								
							button.search-object__submit.button-primary(type="submit")
								+svg('search-filter', 20,20)
								|Найти

	section.main-catalog.page-section
		.container-fluid
			h2 Каталог услуг

			.main-catalog__body 
				a(href="#") 
					figure: +svg('main-catalog', 40,40)
